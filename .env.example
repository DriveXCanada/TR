# DriveX Field Operations — environment
# Copy to .env.local. Never commit real secrets.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgres://postgres@localhost:5432/drivex"

# --- Session signing (32+ bytes). Generate: openssl rand -base64 48 ---
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-please"

# --- Public base URL. Used to build the absolute kiosk QR target. ---
AUTH_URL="http://localhost:3000"

# --- Master account, provisioned on boot (idempotent) ---
MASTER_USERNAME="lead"
MASTER_PIN="4821"
MASTER_NAME="Field Unit Leader"

# --- Optional AI. Server-side only; never referenced from client code.
# Absent key = AI features degrade off, core app fully functional.
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-sonnet-5"

# --- Optional: load the fictional sample deployment on boot (once) ---
# SEED_DEMO="true"
