{
  "name": "drivex-field-operations",
  "version": "0.1.0",
  "private": true,
  "description": "DriveX Field Operations \u2014 disaster-relief field kitchen console, themed for Team Rubicon Canada",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:purge": "tsx src/lib/jobs/purge.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "dev": "next dev",
    "lint": "eslint src --ext .ts,.tsx",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.0",
    "jose": "^5.9.6",
    "next": "^15.5.25",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "playwright-core": "^1.49.1"
  }
}
